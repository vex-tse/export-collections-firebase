---
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<main class="page-shell">
		<section class="login-panel" aria-labelledby="page-title">
			<header class="intro">
				<h1 id="page-title">Exportador de colecciones</h1>
				<p>Exporta y gestiona tus datos de Firebase</p>
			</header>

			<div class="login-card">
				<button
					class="google-button"
					id="google-sign-in"
					type="button"
					aria-label="Continuar con Google"
				>
					<svg class="google-mark" viewBox="0 0 48 48" aria-hidden="true">
						<path
							fill="#4285F4"
							d="M43.6 24.5c0-1.4-.1-2.8-.4-4.1H24v7.8h11c-.5 2.5-2 4.6-4.2 6v5.1h6.8c4-3.7 6-9 6-14.8Z"
						/>
						<path
							fill="#34A853"
							d="M24 44c5.5 0 10.1-1.8 13.5-4.8l-6.8-5.1c-1.9 1.3-4.1 2-6.7 2-5.2 0-9.6-3.5-11.2-8.2H5.8v5.2C9.2 39.6 16.1 44 24 44Z"
						/>
						<path
							fill="#FBBC05"
							d="M12.8 27.9a12 12 0 0 1 0-7.7V15H5.8a20 20 0 0 0 0 18.1l7-5.2Z"
						/>
						<path
							fill="#EA4335"
							d="M24 12c3 0 5.7 1 7.8 3.1l5.9-5.9C34.1 5.8 29.5 4 24 4 16.1 4 9.2 8.4 5.8 15l7 5.2C14.4 15.5 18.8 12 24 12Z"
						/>
					</svg>
					<span id="google-button-label">Continuar con Google</span>
				</button>
				<div
					class="auth-notification"
					id="auth-notification"
					role="alert"
					aria-live="assertive"
					hidden
				>
					<span class="auth-notification-icon" aria-hidden="true">×</span>
					<p id="auth-notification-message"></p>
				</div>
			</div>
		</section>
	</main>
</Layout>

<script>
	import { FirebaseError } from 'firebase/app';
	import { onAuthStateChanged } from 'firebase/auth';
	import { FirebaseConfigError, getFirebaseAuth } from '../lib/firebase';
	import {
		authorizeGoogleUser,
		getAuthFailureReason,
		isAuthFailureReason,
		loginWithGoogle,
		logout,
		type AuthFailureReason,
	} from '../lib/firebase/auth';

	const signInButton = document.querySelector<HTMLButtonElement>('#google-sign-in');
	const signInLabel = document.querySelector<HTMLSpanElement>('#google-button-label');
	const authNotification = document.querySelector<HTMLDivElement>('#auth-notification');
	const authNotificationMessage = document.querySelector<HTMLParagraphElement>(
		'#auth-notification-message',
	);

	if (!signInButton || !signInLabel || !authNotification || !authNotificationMessage) {
		throw new Error('No se encontraron los controles de inicio de sesión.');
	}

	const authFailureMessages: Record<AuthFailureReason, string> = {
		unauthorized: 'Tu cuenta no está autorizada para acceder.',
		cancelled: 'El inicio de sesión se canceló.',
		'verification-failed': 'No se pudo verificar el acceso. Inténtalo de nuevo.',
		'sign-in-failed': 'No se pudo iniciar sesión. Inténtalo de nuevo.',
	};

	function showAuthNotification(reason: AuthFailureReason) {
		authNotificationMessage.textContent = authFailureMessages[reason];
		authNotification.dataset.variant = reason;
		authNotification.hidden = false;
	}

	function clearAuthNotification() {
		authNotification.hidden = true;
		authNotificationMessage.textContent = '';
	}

	function logAuthError(error: unknown, context: 'authorization' | 'sign-in' = 'sign-in') {
		const operation =
			context === 'authorization'
				? 'No se pudo verificar la autorización de la cuenta.'
				: 'No se pudo iniciar sesión con Google.';

		if (error instanceof FirebaseConfigError) {
			console.error('No se pudo configurar Firebase Authentication.', error);
			return;
		}

		if (error instanceof FirebaseError) {
			console.error(operation, error.code, error);
			return;
		}

		console.error(operation, error);
	}

	const redirectError = new URLSearchParams(window.location.search).get('authError');
	if (isAuthFailureReason(redirectError)) {
		showAuthNotification(redirectError);
		const currentUrl = new URL(window.location.href);
		currentUrl.searchParams.delete('authError');
		window.history.replaceState(
			null,
			'',
			`${currentUrl.pathname}${currentUrl.search}${currentUrl.hash}`,
		);
	}

	try {
		const auth = getFirebaseAuth();
		let navigating = false;
		let signInInProgress = false;

		function openDemo() {
			if (navigating) {
				return;
			}
			navigating = true;
			window.history.replaceState(null, '', '/export');
			window.location.replace('/export');
		}

		onAuthStateChanged(
			auth,
			async (user) => {
				if (!user || signInInProgress) {
					return;
				}

				try {
					await authorizeGoogleUser(user);
					openDemo();
				} catch (error) {
					logAuthError(error, 'authorization');
					try {
						await logout();
					} catch (logoutError) {
						console.error('No se pudo cerrar la sesión no autorizada.', logoutError);
					}
					showAuthNotification(getAuthFailureReason(error, 'authorization'));
				}
			},
			async (error) => {
				logAuthError(error, 'authorization');
				try {
					await logout();
				} catch (logoutError) {
					console.error('No se pudo cerrar la sesión tras fallar la verificación.', logoutError);
				}
				showAuthNotification(getAuthFailureReason(error, 'authorization'));
			},
		);

		signInButton.addEventListener('click', async () => {
			signInInProgress = true;
			signInButton.disabled = true;
			signInLabel.textContent = 'Conectando con Google...';
			clearAuthNotification();

			try {
				await loginWithGoogle();
				signInInProgress = false;
				openDemo();
			} catch (error) {
				signInInProgress = false;
				logAuthError(error);
				showAuthNotification(getAuthFailureReason(error));
				signInButton.disabled = false;
				signInLabel.textContent = 'Continuar con Google';
			}
		});
	} catch (error) {
		logAuthError(error);
		signInButton.disabled = true;
	}
</script>

<style>
	.page-shell {
		display: grid;
		min-height: 100vh;
		place-items: start center;
		padding: 10vh 24px 24px;
	}

	.login-panel {
		width: min(100%, 760px);
		min-width: 0;
		margin-inline: auto;
	}

	.intro {
		margin-bottom: 32px;
		text-align: left;
	}

	h1 {
		margin: 0;
		color: #1b2b40;
		font-size: clamp(34px, 4.6vw, 46px);
		font-weight: 600;
		letter-spacing: -0.045em;
		line-height: 1.2;
	}

	.intro p {
		margin: 10px 0 0;
		color: #596b80;
		font-size: 14px;
		line-height: 1.5;
		text-align: left;
	}

	.login-card {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 18px;
		padding: 64px;
		border: 1px solid #e4eaf1;
		border-radius: 22px;
		background: #fff;
		box-shadow: 0 18px 50px rgb(34 55 80 / 8%);
	}

	.auth-notification {
		display: flex;
		width: min(100%, 420px);
		align-items: center;
		gap: 12px;
		padding: 12px 14px;
		border: 1px solid var(--notification-border);
		border-radius: 10px;
		background: var(--notification-background);
		color: var(--notification-color);
		--notification-border: #d7dce2;
		--notification-background: #f5f6f7;
		--notification-color: #4b5563;
		--notification-icon-background: #e5e7eb;
		--notification-icon-color: #4b5563;
	}

	.auth-notification[data-variant='cancelled'] {
		--notification-border: #d7dce2;
		--notification-background: #f5f6f7;
		--notification-color: #4b5563;
		--notification-icon-background: #e5e7eb;
		--notification-icon-color: #4b5563;
	}

	.auth-notification[data-variant='unauthorized'] {
		--notification-border: #bfdbfe;
		--notification-background: #eff6ff;
		--notification-color: #1d4ed8;
		--notification-icon-background: #dbeafe;
		--notification-icon-color: #1d4ed8;
	}

	.auth-notification[data-variant='verification-failed'],
	.auth-notification[data-variant='sign-in-failed'] {
		--notification-border: #f1c5c2;
		--notification-background: #fff5f4;
		--notification-color: #8c2822;
		--notification-icon-background: #fbe1df;
		--notification-icon-color: #a52c25;
	}

	.auth-notification[hidden] {
		display: none;
	}

	.auth-notification-icon {
		display: grid;
		width: 24px;
		height: 24px;
		flex: 0 0 auto;
		place-items: center;
		border-radius: 50%;
		background: var(--notification-icon-background);
		color: var(--notification-icon-color);
		font-size: 19px;
		font-weight: 700;
		line-height: 1;
	}

	.auth-notification p {
		margin: 0;
		font-size: 13px;
		line-height: 1.5;
	}

	.google-button {
		display: flex;
		width: fit-content;
		min-width: 260px;
		max-width: 100%;
		min-height: 72px;
		align-items: center;
		justify-content: center;
		gap: 12px;
		padding: 0 24px;
		border: 1px solid #d6dee8;
		border-radius: 12px;
		background: #fff;
		color: #34445a;
		cursor: pointer;
		font: inherit;
		font-size: 15px;
		font-weight: 600;
		transition: background 150ms ease, border-color 150ms ease, box-shadow 150ms ease;
	}

	.google-button:hover {
		border-color: #b7c5d5;
		background: #f9fbfd;
		box-shadow: 0 3px 10px rgb(34 55 80 / 6%);
	}

	.google-button:disabled {
		cursor: wait;
		opacity: 0.65;
	}

	.google-button:focus-visible {
		outline: 3px solid rgb(40 118 191 / 35%);
		outline-offset: 3px;
	}

	.google-mark {
		width: 19px;
		height: 19px;
	}

	@media (max-width: 760px) {
		.page-shell {
			padding: 8vh 16px 24px;
		}

		.login-card {
			padding: 40px;
		}
	}

	@media (max-width: 380px) {
		.page-shell {
			padding-right: 12px;
			padding-left: 12px;
		}

		.google-button {
			width: min(100%, 260px);
			min-width: 0;
		}

		h1 {
			font-size: 28px;
		}

		.login-card {
			padding: 24px;
		}
	}
</style>
