---
import Layout from '../layouts/Layout.astro';
---

<Layout
	title="Demostración | Firebase Collections"
	description="Vista de demostración del exportador de colecciones."
>
	<main class="page-shell" id="demo-page" aria-busy="true">
		<div class="workspace">
			<header class="topbar">
				<div class="brand">
					<span class="brand-mark" aria-hidden="true">F</span>
					<span>Firebase Collections</span>
					<span class="demo-badge">DEMO</span>
				</div>
				<div class="user-session">
					<span class="user-email" id="user-email"></span>
					<span class="user-role-badge" id="user-role" aria-live="polite"></span>
					<button class="sign-out-button" id="sign-out" type="button" disabled>
						Cerrar sesión
					</button>
				</div>
			</header>

			<div class="session-loading" id="session-loading" role="status" aria-live="polite">
				<span class="loading-spinner" aria-hidden="true"></span>
				<span>Verificando el acceso...</span>
			</div>

			<section class="page-heading" aria-labelledby="page-title">
				<p class="eyebrow">VISTA DE DEMOSTRACIÓN</p>
				<h1 id="page-title">Exportar colecciones</h1>
				<p class="subtitle">
					Explora la interfaz de ejemplo. Esta demostración no lee ni modifica datos de Firestore.
				</p>
			</section>

			<section class="export-card" aria-label="Opciones de demostración">
				<div class="field-grid">
					<div class="field">
						<label for="database">Base de datos</label>
						<select id="database" name="database" disabled>
							<option value="" selected disabled>Selecciona una base de datos</option>
							<option value="primary">Base principal (demo)</option>
							<option value="test">Base de pruebas (demo)</option>
						</select>
					</div>

					<div class="field">
						<label for="collection">Colección</label>
						<select id="collection" name="collection" disabled>
							<option value="" selected disabled>Selecciona una colección</option>
							<option value="Personas">Personas</option>
							<option value="Productos">Productos</option>
							<option value="Pedidos">Pedidos</option>
						</select>
					</div>

					<div class="field">
						<label for="time-range">Lapso de tiempo</label>
						<select id="time-range" name="time-range" disabled>
							<option value="" selected disabled>Selecciona un período</option>
							<option value="all">Todo el historial</option>
							<option value="7-days">Últimos 7 días</option>
							<option value="30-days">Últimos 30 días</option>
							<option value="custom">Período personalizado</option>
						</select>
					</div>

					<div class="field">
						<label for="file-format">Formato del archivo</label>
						<select id="file-format" name="file-format" disabled>
							<option value="" selected disabled>Selecciona un formato</option>
							<option value="csv">CSV (.csv)</option>
							<option value="json">JSON (.json)</option>
							<option value="excel">Excel (.xlsx)</option>
						</select>
					</div>
				</div>

				<div class="card-footer">
					<p class="sample-note">Opciones de ejemplo; no se genera ningún archivo.</p>
					<button class="export-button" id="demo-export" type="button" disabled>
						Probar demostración
					</button>
				</div>
				<p class="demo-feedback" id="demo-feedback" role="status" aria-live="polite"></p>
			</section>
		</div>
	</main>
</Layout>

<script>
	import { onAuthStateChanged } from 'firebase/auth';
	import { getFirebaseAuth } from '../lib/firebase';
	import {
		authorizeGoogleUser,
		getAuthFailureReason,
		logout,
		type AuthFailureReason,
	} from '../lib/firebase/auth';

	const demoPage = document.querySelector<HTMLElement>('#demo-page');
	const sessionLoading = document.querySelector<HTMLDivElement>('#session-loading');
	const userEmail = document.querySelector<HTMLSpanElement>('#user-email');
	const signOutButton = document.querySelector<HTMLButtonElement>('#sign-out');
	const demoExportButton = document.querySelector<HTMLButtonElement>('#demo-export');
	const demoFeedback = document.querySelector<HTMLParagraphElement>('#demo-feedback');

	if (
		!demoPage ||
		!sessionLoading ||
		!userEmail ||
		!signOutButton ||
		!demoExportButton ||
		!demoFeedback
	) {
		throw new Error('No se encontraron los controles de la página de demostración.');
	}

	const formControls = demoPage.querySelectorAll<HTMLButtonElement | HTMLSelectElement>(
		'button, select',
	);

	function redirectToLogin(reason?: AuthFailureReason) {
		const loginUrl = new URL('/', window.location.origin);
		if (reason) {
			loginUrl.searchParams.set('authError', reason);
		}
		window.location.replace(loginUrl.toString());
	}

	try {
		const auth = getFirebaseAuth();

		onAuthStateChanged(
			auth,
			async (user) => {
				if (!user) {
					window.location.replace('/');
					return;
				}

				try {
					const authorizedSession = await authorizeGoogleUser(user);

					const role = authorizedSession.role.toUpperCase();
					userEmail.textContent = user.displayName
						? `${user.displayName} · ${user.email ?? ''}`
						: user.email ?? 'Cuenta Google';
					const roleBadge = document.querySelector<HTMLSpanElement>('#user-role');
					if (roleBadge) {
						roleBadge.textContent = role;
						roleBadge.dataset.role = authorizedSession.role;
					}

					if (authorizedSession.role === 'viewer') {
						demoExportButton.disabled = true;
						demoExportButton.textContent = 'Solo lectura';
						demoFeedback.textContent = 'Tu rol es viewer: puedes consultar la vista, pero no exportar datos.';
					}

					for (const control of formControls) {
						if (control !== demoExportButton || authorizedSession.role !== 'viewer') {
							control.disabled = false;
						}
					}
					sessionLoading.hidden = true;
					demoPage.setAttribute('aria-busy', 'false');
				} catch (error) {
					console.error('No se pudo completar la verificación de autorización.', error);
					const failureReason = getAuthFailureReason(error, 'authorization');
					try {
						await logout();
					} catch (logoutError) {
						console.error('No se pudo cerrar la sesión no autorizada.', logoutError);
					}
					redirectToLogin(failureReason);
				}
			},
			async (error) => {
				console.error('No se pudo comprobar la sesión de demostración.', error);
				try {
					await logout();
				} catch (logoutError) {
					console.error('No se pudo cerrar la sesión tras fallar la verificación.', logoutError);
				}
				redirectToLogin(getAuthFailureReason(error, 'authorization'));
			},
		);

		signOutButton.addEventListener('click', async () => {
			signOutButton.disabled = true;
			try {
				await logout();
				window.location.replace('/');
			} catch (error) {
				console.error('No se pudo cerrar la sesión de Google.', error);
				signOutButton.disabled = false;
			}
		});
	} catch (error) {
		console.error('No se pudo inicializar Firebase Authentication.', error);
		redirectToLogin(getAuthFailureReason(error, 'authorization'));
	}

	demoExportButton.addEventListener('click', () => {
		demoFeedback.textContent = 'La demostración está activa; todavía no se consultan datos ni se exportan archivos.';
	});
</script>

<style>
	[hidden] {
		display: none !important;
	}

	.session-loading {
		display: flex;
		min-height: 42px;
		align-items: center;
		gap: 10px;
		margin-top: 20px;
		color: #596b80;
		font-size: 14px;
	}

	.loading-spinner {
		width: 18px;
		height: 18px;
		flex: 0 0 auto;
		border: 2px solid #d6dee8;
		border-top-color: #1768b5;
		border-radius: 50%;
		animation: spin 750ms linear infinite;
	}

	@keyframes spin {
		to {
			transform: rotate(360deg);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.loading-spinner {
			animation: none;
		}
	}

	.page-shell {
		min-height: 100vh;
		padding: 32px 20px 56px;
	}

	.workspace {
		width: min(100%, 980px);
		margin: 0 auto;
	}

	.topbar,
	.brand,
	.user-session {
		display: flex;
		align-items: center;
	}

	.topbar {
		justify-content: space-between;
		gap: 16px;
	}

	.brand {
		gap: 10px;
		color: #17243b;
		font-size: 14px;
		font-weight: 700;
	}

	.brand-mark {
		display: grid;
		width: 34px;
		height: 34px;
		place-items: center;
		border-radius: 9px;
		background: #e7f2ff;
		color: #1768b5;
	}

	.demo-badge {
		padding: 4px 8px;
		border-radius: 999px;
		background: #fff3d6;
		color: #845b00;
		font-size: 10px;
		letter-spacing: 0.08em;
	}

	.user-session {
		gap: 14px;
	}

	.user-role-badge {
		display: inline-flex;
		align-items: center;
		padding: 5px 10px;
		border-radius: 999px;
		background: #e9f5ff;
		color: #125fa9;
		font-size: 10px;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.user-email {
		color: #718095;
		font-size: 12px;
		overflow-wrap: anywhere;
	}

	.sign-out-button,
	.export-button {
		min-height: 42px;
		padding: 0 14px;
		border-radius: 8px;
		cursor: pointer;
		font: inherit;
		font-size: 13px;
		font-weight: 600;
	}

	.sign-out-button {
		border: 1px solid #d6dee8;
		background: white;
		color: #536d86;
		transition:
			border-color 150ms ease,
			background 150ms ease,
			color 150ms ease;
	}

	.sign-out-button:not(:disabled):hover {
		border-color: #b7c5d5;
		background: #f9fbfd;
		color: #34445a;
	}

	.page-heading {
		margin: 64px 0 28px;
	}

	.eyebrow {
		margin: 0 0 10px;
		color: #52789b;
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.13em;
	}

	h1 {
		margin: 0;
		color: #1b2b40;
		font-size: clamp(30px, 5vw, 42px);
		letter-spacing: -0.05em;
	}

	.subtitle {
		max-width: 650px;
		margin: 12px 0 0;
		color: #718095;
		font-size: 14px;
		line-height: 1.6;
	}

	.export-card {
		padding: clamp(22px, 5vw, 40px);
		border: 1px solid #e4eaf1;
		border-radius: 18px;
		background: #fff;
		box-shadow: 0 18px 50px rgb(34 55 80 / 7%);
	}

	.field-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 22px;
	}

	.field label {
		display: block;
		margin-bottom: 8px;
		color: #34445a;
		font-size: 13px;
		font-weight: 600;
	}

	.field select {
		width: 100%;
		min-height: 48px;
		padding: 0 12px;
		border: 1px solid #d6dee8;
		border-radius: 8px;
		background: white;
		color: #405269;
		font: inherit;
		font-size: 14px;
		cursor: pointer;
		transition:
			border-color 150ms ease,
			box-shadow 150ms ease;
	}

	.field select:not(:disabled):hover {
		border-color: #b7c5d5;
	}

	.card-footer {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 16px;
		margin-top: 30px;
		padding-top: 22px;
		border-top: 1px solid #edf1f5;
	}

	.sample-note,
	.demo-feedback {
		margin: 0;
		color: #8997a7;
		font-size: 12px;
		line-height: 1.5;
	}

	.export-button {
		border: 0;
		background: #1768b5;
		color: white;
		transition:
			background 150ms ease,
			box-shadow 150ms ease,
			transform 150ms ease;
	}

	.export-button:not(:disabled):hover {
		background: #125996;
		box-shadow: 0 6px 16px rgb(23 104 181 / 18%);
		transform: translateY(-1px);
	}

	.export-button:disabled {
		background: #e3e9ef;
		color: #788697;
		cursor: not-allowed;
	}

	.demo-feedback {
		margin-top: 14px;
		color: #26734d;
	}

	.sign-out-button:focus-visible,
	.export-button:focus-visible,
	.field select:focus-visible {
		outline: 3px solid rgb(40 118 191 / 35%);
		outline-offset: 3px;
	}

	@media (max-width: 640px) {
		.topbar,
		.user-session,
		.card-footer {
			align-items: stretch;
			flex-direction: column;
		}

		.user-session {
			align-items: flex-start;
		}

		.field-grid {
			grid-template-columns: 1fr;
		}

		.page-heading {
			margin-top: 46px;
		}

		.export-button {
			width: 100%;
		}
	}
</style>
